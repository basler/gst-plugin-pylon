#!/usr/bin/make -f

# uncomment for verbose logging
export DH_VERBOSE = 1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -Wall -pedantic
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Debian Python layout so Meson installs into dist-packages (not site-packages)
export DEB_PYTHON_INSTALL_LAYOUT = deb

# Emulators for camemu functional tests during the package build
export PYLON_CAMEMU ?= 3
export PYLON_ROOT ?= /opt/pylon
# Ensure pylon libs are visible under fakeroot (which resets LD_LIBRARY_PATH)
export LD_LIBRARY_PATH := /opt/pylon/lib$(if $(LD_LIBRARY_PATH),:$(LD_LIBRARY_PATH))

%:
	dh $@ --with python3 --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dpython-bindings=enabled

# Skip tests for nvidia profile builds when not on NVIDIA hardware.
# Otherwise run the full Meson test suite (including camemu).
override_dh_auto_test:
	if echo "$(DEB_BUILD_PROFILES)" | grep -q "nvidia"; then \
		if [ ! -f /proc/device-tree/compatible ] || ! grep -q "nvidia" /proc/device-tree/compatible; then \
			echo "Skipping tests: NVIDIA profile detected but not running on NVIDIA hardware"; \
			exit 0; \
		fi; \
	fi
	dh_auto_test

# handle pylon libs versioning and rpath
override_dh_shlibdeps:
	dh_shlibdeps -a -l/opt/pylon/lib -- --ignore-missing-info
